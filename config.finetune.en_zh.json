{
    "base_model": "Helsinki-NLP/opus-mt-en-zh",
    "revision": "408d9bc410a388e1d9aef112a2daba955b945255",
    "source_language": "en",
    "target_language": "zh",
    "target_prefix": ">>cmn_Hans<< ",
    "output_dir": "./output/accurate_finetuned_en_zh",
    "datasets": [
        {
            "path": "./data/iwslt2017_zh_en_fast.parquet",
            "weight": 0.7,
            "domain": "spoken"
        },
        {
            "path": "./data/combined_general_en_zh.parquet",
            "weight": 0.2,
            "domain": "general"
        },
        {
            "path": "./data/opus_openoffice_en_zh.parquet",
            "weight": 0.1,
            "domain": "technical"
        }
    ],
    "max_train_samples": 12000,
    "validation_samples": 256,
    "max_source_tokens": 192,
    "max_target_tokens": 192,
    "micro_batch_size": 8,
    "gradient_accumulation_steps": 4,
    "num_epochs": 20,
    "max_steps": 200,
    "continue_from_best": true,
    "learning_rate": 0.00001,
    "weight_decay": 0.01,
    "warmup_ratio": 0.06,
    "max_grad_norm": 1.0,
    "checkpoint_steps": 375,
    "log_steps": 5,
    "seed": 43,
    "max_allowed_validation_loss_regression": 0.0,
    "blacklist_file": "./data/training_blacklist.json",
    "eval_dataset": "./eval/translation_eval.jsonl",
    "eval_split": "dev",
    "early_stopping_patience": 3,
    "early_stopping_min_delta": 0.001,
    "max_domain_fractions": {
        "military": 0.03
    }
}
