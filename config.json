{
    "model": 
    {
        "d_model": 512,
        "d_hidden": 2048,
        "num_heads": 8,
        "drop_prob": 0.1,
        "num_encode_layers": 6,
        "num_decode_layers": 6,
        "source_seq_len": 256,
        "target_seq_len": 256
    },

    "tokenizer": 
    {
        "vocab_size": 8000,
        "min_frequency": 2,
        "tokenizers_dir":"./output/tokenizers"
    },

    "data": 
    {
        "dataset_path": "./data/opus_openoffice_en_zh.parquet",
        "source_language": "zh_CN",
        "target_language": "en_GB",
        "train_size": 0.9,
        "test_size":0.1,
        "seed": 0
    },

    "train":
    {
        "batch_size":16,
        "num_epochs":3,
        "warmup": 4000,
        "warmup_factor": 1.0,
        "label_smoothing":0.1,
        "max_grad_norm":1.0,
        "num_workers":0,
        "check_steps":2000,
        "patience_times":5,
        "min_progress_value":0.0005,
        "checkpoints_dir":"./output/checkpoints"
    },

    "run":
    {
        "zh_tokenizer_file_name":"zh_tokenizer.json",
        "en_tokenizer_file_name":"en_tokenizer.json",
        "selected_checkpoint":"best_state_from_checker.pt",
        "max_new_tokens":96,
        "repetition_penalty":1.15,
        "no_repeat_ngram_size":3
    }
}
